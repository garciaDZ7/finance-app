generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum GroupType {
  PERSONAL
  PERMANENT
  EVENT

  @@map("group_type")
}

enum GroupMemberRole {
  MEMBER
  ADMIN

  @@map("group_member_role")
}

enum CategoryScope {
  PERSONAL
  GROUP

  @@map("category_scope")
}

enum TransactionType {
  INCOME
  EXPENSE

  @@map("transaction_type")
}

enum SplitMethod {
  EQUAL
  CUSTOM

  @@map("split_method")
}

enum SplitParticipantStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@map("split_participant_status")
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED

  @@map("goal_status")
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY

  @@map("recurring_frequency")
}

enum RecurringTransactionStatus {
  ACTIVE
  PAUSED
  ENDED
  CANCELLED

  @@map("recurring_transaction_status")
}

enum AttachmentFileType {
  IMAGE
  PDF
  OTHER

  @@map("attachment_file_type")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String?
  email     String   @unique
  role      UserRole @default(USER)
  mustChangePassword Boolean @default(true) @map("must_change_password")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attachments             Attachment[]           @relation("AttachmentUploadedBy")
  categories              Category[]             @relation("CategoryCreatedBy")
  goalContributions       GoalContribution[]
  goals                   Goal[]                 @relation("GoalOwner")
  groupInvitations        GroupMember[]          @relation("GroupMemberInvitedBy")
  groupsCreated           Group[]                @relation("GroupCreatedBy")
  memberships             GroupMember[]
  payments                Payment[]              @relation("PaymentPaidBy")
  recurringTransactions   RecurringTransaction[] @relation("RecurringTransactionOwner")
  splitParticipants       SplitParticipant[]
  transactionsResponsible Transaction[]          @relation("TransactionResponsibleUser")

  @@map("users")
}

model Group {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  type        GroupType @default(PERMANENT)
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  categories            Category[]
  goals                 Goal[]
  members               GroupMember[]
  recurringTransactions RecurringTransaction[]
  transactions          Transaction[]

  @@index([createdById])
  @@index([type])
  @@map("groups")
}

model GroupMember {
  id       String          @id @default(uuid()) @db.Uuid
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now()) @map("joined_at")
  leftAt   DateTime?       @map("left_at")

  groupId String @map("group_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  invitedById String? @map("invited_by_id") @db.Uuid

  group     Group @relation(fields: [groupId], references: [id], onDelete: Restrict)
  invitedBy User? @relation("GroupMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  user      User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([invitedById])
  @@map("group_members")
}

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  scope       CategoryScope
  color       String?
  icon        String?
  isArchived  Boolean       @default(false) @map("is_archived")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  createdById String  @map("created_by_id") @db.Uuid
  groupId     String? @map("group_id") @db.Uuid

  createdBy User   @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  group     Group? @relation(fields: [groupId], references: [id], onDelete: Restrict)

  recurringTransactions RecurringTransaction[]
  transactions          Transaction[]

  @@unique([groupId, name])
  @@index([createdById])
  @@index([groupId])
  @@index([scope])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  occurredAt  DateTime        @map("occurred_at")
  description String
  note        String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  categoryId             String? @map("category_id") @db.Uuid
  groupId                String? @map("group_id") @db.Uuid
  recurringTransactionId String? @map("recurring_transaction_id") @db.Uuid
  responsibleUserId      String  @map("responsible_user_id") @db.Uuid

  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  group                Group?                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  responsibleUser      User                  @relation("TransactionResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)

  attachment Attachment?
  split      Split?

  @@index([categoryId])
  @@index([groupId])
  @@index([occurredAt])
  @@index([recurringTransactionId])
  @@index([responsibleUserId])
  @@index([type])
  @@map("transactions")
}

model Split {
  id          String      @id @default(uuid()) @db.Uuid
  method      SplitMethod
  totalAmount Decimal     @map("total_amount") @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  transactionId String @unique @map("transaction_id") @db.Uuid

  transaction  Transaction        @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  participants SplitParticipant[]
  payments     Payment[]

  @@index([method])
  @@map("splits")
}

model SplitParticipant {
  id        String                 @id @default(uuid()) @db.Uuid
  amountDue Decimal                @map("amount_due") @db.Decimal(12, 2)
  status    SplitParticipantStatus @default(PENDING)
  note      String?
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  splitId String @map("split_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  split    Split     @relation(fields: [splitId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([splitId, userId])
  @@index([status])
  @@index([userId])
  @@map("split_participants")
}

model Payment {
  id        String   @id @default(uuid()) @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @map("paid_at")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  paidById           String  @map("paid_by_id") @db.Uuid
  splitId            String  @map("split_id") @db.Uuid
  splitParticipantId String? @map("split_participant_id") @db.Uuid

  paidBy           User              @relation("PaymentPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  split            Split             @relation(fields: [splitId], references: [id], onDelete: Restrict)
  splitParticipant SplitParticipant? @relation(fields: [splitParticipantId], references: [id], onDelete: SetNull)

  attachment Attachment?

  @@index([paidAt])
  @@index([paidById])
  @@index([splitId])
  @@index([splitParticipantId])
  @@map("payments")
}

model Goal {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  targetAmount Decimal    @map("target_amount") @db.Decimal(12, 2)
  dueDate      DateTime?  @map("due_date")
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  groupId String? @map("group_id") @db.Uuid
  userId  String? @map("user_id") @db.Uuid

  group Group? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user  User?  @relation("GoalOwner", fields: [userId], references: [id], onDelete: Restrict)

  contributions GoalContribution[]

  @@index([dueDate])
  @@index([groupId])
  @@index([status])
  @@index([userId])
  @@map("goals")
}

model GoalContribution {
  id            String   @id @default(uuid()) @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  contributedAt DateTime @map("contributed_at")
  note          String?
  isAutomatic   Boolean  @default(false) @map("is_automatic")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  goalId String @map("goal_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([contributedAt])
  @@index([goalId])
  @@index([userId])
  @@map("goal_contributions")
}

model Attachment {
  id          String             @id @default(uuid()) @db.Uuid
  fileName    String             @map("file_name")
  fileType    AttachmentFileType @map("file_type")
  mimeType    String             @map("mime_type")
  fileSize    Int?               @map("file_size")
  storagePath String             @map("storage_path")
  publicUrl   String?            @map("public_url")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  paymentId     String? @unique @map("payment_id") @db.Uuid
  transactionId String? @unique @map("transaction_id") @db.Uuid
  uploadedById  String  @map("uploaded_by_id") @db.Uuid

  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  uploadedBy  User         @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([fileType])
  @@index([uploadedById])
  @@map("attachments")
}

model RecurringTransaction {
  id          String                     @id @default(uuid()) @db.Uuid
  type        TransactionType
  amount      Decimal                    @db.Decimal(12, 2)
  description String
  note        String?
  frequency   RecurringFrequency
  status      RecurringTransactionStatus @default(ACTIVE)
  startsAt    DateTime                   @map("starts_at")
  endsAt      DateTime?                  @map("ends_at")
  nextRunAt   DateTime                   @map("next_run_at")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  categoryId String? @map("category_id") @db.Uuid
  groupId    String? @map("group_id") @db.Uuid
  ownerId    String  @map("owner_id") @db.Uuid

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  group    Group?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  owner    User      @relation("RecurringTransactionOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  transactions Transaction[]

  @@index([categoryId])
  @@index([frequency])
  @@index([groupId])
  @@index([nextRunAt])
  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@map("recurring_transactions")
}
